<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CodePlayer"  parent="Theme.Space">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:ignore="NewApi">true</item>
    </style>

    <style name="Theme.CodePlayer.Toolbar.Title" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/semi_bold</item>
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/semi_bold</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Theme.CodePlayer.Toolbar.SubTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/_8sdp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>